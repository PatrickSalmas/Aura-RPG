n\t}\r\n}\r\n#else\r\nvoid SampleCurve_Emitter_ScaleAlpha_FloatCurve001(float Time, out float1 Value)\r\n{\r\n\tuint IndexA, IndexB;\r\n\tfloat Fraction;\r\n\tGetCurveLUTIndices_Emitter_ScaleAlpha_FloatCurve001(Time, IndexA, IndexB, Fraction);\r\n\r\n\tIndexA *= 1;\r\n\tIndexB *= 1;\r\n\r\n\t[unroll]\r\n\tfor ( int i=0; i < 1; ++i )\r\n\t{\r\n\t\tValue[i] = lerp(SampleCurveLUT_Emitter_ScaleAlpha_FloatCurve001(IndexA + i), SampleCurveLUT_Emitter_ScaleAlpha_FloatCurve001(IndexB + i), Fraction);\r\n\t}\r\n}\r\n#endif\r\n\nfloat3 Emitter_VectorField32_TilingAxes;\nfloat3 Emitter_VectorField32_Dimensions;\nfloat3 Emitter_VectorField32_MinBounds;\nfloat3 Emitter_VectorField32_MaxBounds;\nTexture3D Emitter_VectorField32_Texture;\nSamplerState Emitter_VectorField32_Sampler;\n// Copyright Epic Games, Inc. All Rights Reserved.\r\n\r\n#ifndef NUM_VIRTUALTEXTURE_SAMPLES\r\n\t#define NUM_VIRTUALTEXTURE_SAMPLES 1\r\n#endif\r\n\r\n#include \"/Engine/Private/VirtualTextureCommon.ush\"\r\n#include \"/Engine/Private/Landscape/LandscapeCommon.ush\"\r\n\r\n// Mirrored from FNiagaraDataInterfaceParametersCS_Landscape\r\n#define VIRTUAL_TEXTURE_UNPACK_NORMAL_NONE 0\r\n#define VIRTUAL_TEXTURE_UNPACK_NORMAL_BC3BC3 1\r\n#define VIRTUAL_TEXTURE_UNPACK_NORMAL_BC5BC1 2\r\n\r\nTexture2D\t\t\tWindForce_LandscapeSample_BaseColorVirtualTexture;\r\nTexture2D<uint4>\tWindForce_LandscapeSample_BaseColorVirtualTexturePageTable;\r\nSamplerState\t\tWindForce_LandscapeSample_BaseColorVirtualTextureSampler;\r\nfloat3\t\t\t\tWindForce_LandscapeSample_BaseColorVirtualTextureLWCTile;\r\nfloat4x4\t\t\tWindForce_LandscapeSample_BaseColorVirtualTextureWorldToUvTransform;\r\nuint\t\t\t\tWindForce_LandscapeSample_BaseColorVirtualTextureSRGB;\r\nuint\t\t\t\tWindForce_LandscapeSample_BaseColorVirtualTextureEnabled;\r\nuint4\t\t\t\tWindForce_LandscapeSample_BaseColorVirtualTexturePackedUniform0;\r\nuint4\t\t\t\tWindForce_LandscapeSample_BaseColorVirtualTexturePackedUniform1;\r\nuint4\t\t\t\tWindForce_LandscapeSample_BaseColorVirtualTextureUniforms;\r\nTexture2D\t\t\tWindForce_LandscapeSample_HeightVirtualTexture;\r\nTexture2D<uint4>\tWindForce_LandscapeSample_HeightVirtualTexturePageTable;\r\nSamplerState\t\tWindForce_LandscapeSample_HeightVirtualTextureSampler;\r\nfloat3\t\t\t\tWindForce_LandscapeSample_HeightVirtualTextureLWCTile;\r\nfloat4x4\t\t\tWindForce_LandscapeSample_HeightVirtualTextureWorldToUvTransform;\r\nuint\t\t\t\tWindForce_LandscapeSample_HeightVirtualTextureEnabled;\r\nuint4\t\t\t\tWindForce_LandscapeSample_HeightVirtualTexturePackedUniform0;\r\nuint4\t\t\t\tWindForce_LandscapeSample_HeightVirtualTexturePackedUniform1;\r\nuint4\t\t\t\tWindForce_LandscapeSample_HeightVirtualTextureUniforms;\r\nTexture2D\t\t\tWindForce_LandscapeSample_NormalVirtualTexture0;\r\nTexture2D\t\t\tWindForce_LandscapeSample_NormalVirtualTexture1;\r\nTexture2D<uint4>\tWindForce_LandscapeSample_NormalVirtualTexturePageTable;\r\nSamplerState\t\tWindForce_LandscapeSample_NormalVirtualTexture0Sampler;\r\nSamplerState\t\tWindForce_LandscapeSample_NormalVirtualTexture1Sampler;\r\nfloat3\t\t\t\tWindForce_LandscapeSample_NormalVirtualTextureLWCTile;\r\nfloat4x4\t\t\tWindForce_LandscapeSample_NormalVirtualTextureWorldToUvTransform;\r\nuint4\t\t\t\tWindForce_LandscapeSample_NormalVirtualTexturePackedUniform0;\r\nuint4\t\t\t\tWindForce_LandscapeSample_NormalVirtualTexturePackedUniform1;\r\nuint4\t\t\t\tWindForce_LandscapeSample_NormalVirtualTextureUniforms0;\r\nuint4\t\t\t\tWindForce_LandscapeSample_NormalVirtualTextureUniforms1;\r\nint\t\t\t\t\tWindForce_LandscapeSample_NormalVirtualTextureUnpackMode;\r\nuint\t\t\t\tWindForce_LandscapeSample_NormalVirtualTextureEnabled;\r\nTexture2D\t\t\tWindForce_LandscapeSample_CachedHeightTexture;\r\nSamplerState\t\tWindForce_LandscapeSample_CachedHeightTextureSampler;\r\nuint\t\t\t\tWindForce_LandscapeSample_CachedHeightTextureEnabled;\r\nfloat3\t\t\t\tWindForce_LandscapeSample_CachedHeightTextureLWCTile;\r\nfloat4x4\t\t\tWindForce_LandscapeSample_CachedHeightTextureWorldToUvTransform;\r\nfloat4x4\t\t\tWindForce_LandscapeSample_CachedHeightTextureUvToWorldTransform;\r\nfloat4\t\t\t\tWindForce_LandscapeSample_CachedHeightTextureUvScaleBias;\r\nfloat2\t\t\t\tWindForce_LandscapeSample_CachedHeightTextureWorldGridSize;\r\nint2\t\t\t\tWindForce_LandscapeSample_CachedHeightTextureDimension;\r\nSamplerState\t\tWindForce_LandscapeSample_PointClampedSampler;\r\nTexture2D<uint>\t\tWindForce_LandscapeSample_CachedPhysMatTexture;\r\nint2\t\t\t\tWindForce_LandscapeSample_CachedPhysMatTextureDimension;\r\nfloat3\t\t\t\tWindForce_LandscapeSample_SystemLWCTile;\r\n\r\nfloat2 GetCachedHeightTextureUv_WindForce_LandscapeSample(float3 InWorldPos)\r\n{\r\n\tFLWCVector4 LwcWorldPos = MakeLWCVector4(WindForce_LandscapeSample_SystemLWCTile, float4(InWorldPos, 1.0f));\r\n\tFLWCInverseMatrix LwcWorldToUv = MakeLWCInverseMatrix(WindForce_LandscapeSample_CachedHeightTextureLWCTile, WindForce_LandscapeSample_CachedHeightTextureWorldToUvTransform);\r\n\r\n\tfloat2 Uv = LWCMultiply(LwcWorldPos, LwcWorldToUv).xy;\r\n\tUv = Uv * WindForce_LandscapeSample_CachedHeightTextureUvScaleBias.xy + WindForce_LandscapeSample_CachedHeightTextureUvScaleBias.zw;\r\n\r\n\treturn Uv;\r\n}\r\n\r\nvoid GetBaseColor_WindForce_LandscapeSample(float3 InWorldPos, out float3 OutBaseColor, out bool OutIsValid)\r\n{\r\n\tif (WindForce_LandscapeSample_BaseColorVirtualTextureEnabled != 0)\r\n\t{\r\n\t\tfloat3 UnpackBaseColorOrigin = WindForce_LandscapeSample_BaseColorVirtualTextureWorldToUvTransform[0].xyz;\r\n\t\tfloat3 UnpackBaseColorU = WindForce_LandscapeSample_BaseColorVirtualTextureWorldToUvTransform[1].xyz;\r\n\t\tfloat3 UnpackBaseColorV = WindForce_LandscapeSample_BaseColorVirtualTextureWorldToUvTransform[2].xyz;\r\n\r\n\t\tFDFVector3 LwcWorldPos = DFFromTileOffset_Hack(MakeLWCVector3(WindForce_LandscapeSample_SystemLWCTile, InWorldPos));\r\n\t\tFDFVector3 LwcBaseColorOrigin = DFFromTileOffset_Hack(MakeLWCVector3(WindForce_LandscapeSample_BaseColorVirtualTextureLWCTile, UnpackBaseColorOrigin));\r\n\t\tfloat2 SampleUv = VirtualTextureWorldToUV(LwcWorldPos, LwcBaseColorOrigin, UnpackBaseColorU, UnpackBaseColorV);\r\n\r\n\t\tVTPageTableResult PageTable = TextureLoadVirtualPageTableLevel(\r\n\t\t\tWindForce_LandscapeSample_BaseColorVirtualTexturePageTable,\r\n\t\t\tVTPageTableUniform_Unpack(WindForce_LandscapeSample_BaseColorVirtualTexturePackedUniform0, WindForce_LandscapeSample_BaseColorVirtualTexturePackedUniform1),\r\n\t\t\tSampleUv,\r\n\t\t\tVTADDRESSMODE_CLAMP,\r\n\t\t\tVTADDRESSMODE_CLAMP,\r\n\t\t\t0.0f);\r\n\r\n\t\tfloat4 PackedValue = TextureVirtualSample(\r\n\t\t\tWindForce_LandscapeSample_BaseColorVirtualTexture,\r\n\t\t\tWindForce_LandscapeSample_BaseColorVirtualTextureSampler,\r\n\t\t\tPageTable,\r\n\t\t\t0,\r\n\t\t\tVTUniform_Unpack(WindForce_LandscapeSample_BaseColorVirtualTextureUniforms));\r\n\r\n\t\tOutBaseColor = WindForce_LandscapeSample_BaseColorVirtualTextureSRGB != 0 ? VirtualTextureUnpackBaseColorSRGB(PackedValue) : VirtualTextureUnpackBaseColorYCoCg(PackedValue);\r\n\t\tOutIsValid = true;\r\n\t}\r\n\telse\r\n\t{\r\n\t\tOutBaseColor = 0.0f;\r\n\t\tOutIsValid = false;\r\n\t}\r\n}\r\n\r\nvoid GetHeight_WindForce_LandscapeSample(float3 InWorldPos, out float OutHeight, out bool OutIsValid)\r\n{\r\n\tif (WindForce_LandscapeSample_HeightVirtualTextureEnabled != 0)\r\n\t{\r\n\t\tfloat3 UnpackHeightOrigin = WindForce_LandscapeSample_HeightVirtualTextureWorldToUvTransform[0].xyz;\r\n\t\tfloat3 UnpackHeightU = WindForce_LandscapeSample_HeightVirtualTextureWorldToUvTransform[1].xyz;\r\n\t\tfloat3 UnpackHeightV = WindForce_LandscapeSample_HeightVirtualTextureWorldToUvTransform[2].xyz;\r\n\t\tfloat2 UnpackHeightScaleBias = WindForce_LandscapeSample_HeightVirtualTextureWorldToUvTransform[3].xy;\r\n\r\n\t\tFDFVector3 LwcWorldPos = DFFromTileOffset_Hack(MakeLWCVector3(WindForce_LandscapeSample_SystemLWCTile, InWorldPos));\r\n\t\tFDFVector3 LwcHeightOrigin = DFFromTileOffset_Hack(MakeLWCVector3(WindForce_LandscapeSample_HeightVirtualTextureLWCTile, UnpackHeightOrigin));\r\n\t\tfloat2 SampleUv = VirtualTextureWorldToUV(LwcWorldPos, LwcHeightOrigin, UnpackHeightU, UnpackHeightV);\r\n\r\n\t\tVTPageTableResult PageTable = TextureLoadVirtualPageTableLevel(\r\n\t\t\tWindForce_LandscapeSample_HeightVirtualTexturePageTable,\r\n\t\t\tVTPageTableUniform_Unpack(WindForce_LandscapeSample_HeightVirtualTexturePackedUniform0, WindForce_LandscapeSample_HeightVirtualTexturePackedUniform1),\r\n\t\t\tSampleUv,\r\n\t\t\tVTADDRESSMODE_CLAMP,\r\n\t\t\tVTADDRESSMODE_CLAMP,\r\n\t\t\t0.0f);\r\n\r\n\t\tfloat4 PackedValue = TextureVirtualSample(\r\n\t\t\tWindForce_LandscapeSample_HeightVirtualTexture,\r\n\t\t\tWindForce_LandscapeSample_HeightVirtualTextureSampler,\r\n\t\t\tPageTable,\r\n\t\t\t0,\r\n\t\t\tVTUniform_Unpack(WindForce_LandscapeSample_HeightVirtualTextureUniforms));\r\n\r\n\t\tOutHeight = VirtualTextureUnpackHeight(PackedValue, UnpackHeightScaleBias);\r\n\t\tOutIsValid = true;\r\n\t}\r\n\telse if (WindForce_LandscapeSample_CachedHeightTextureEnabled != 0)\r\n\t{\r\n\t\tfloat2 Uv = GetCachedHeightTextureUv_WindForce_LandscapeSample(InWorldPos);\r\n\r\n\t\tOutHeight = WindForce_LandscapeSample_CachedHeightTexture.SampleLevel(WindForce_LandscapeSample_CachedHeightTextureSampler, Uv, 0).x;\r\n\t\tOutIsValid = true;\r\n\t}\r\n\telse\r\n\t{\r\n\t\tOutHeight = InWorldPos.z;\r\n\t\tOutIsValid = false;\r\n\t}\r\n}\r\n\r\nvoid GetWorldNormal_WindForce_LandscapeSample(float3 InWorldPos, out float3 OutNormal, out bool OutIsValid)\r\n{\r\n\tif (WindForce_LandscapeSample_NormalVirtualTextureEnabled != 0)\r\n\t{\r\n\t\tfloat3 UnpackNormalOrigin = WindForce_LandscapeSample_NormalVirtualTextureWorldToUvTransform[0].xyz;\r\n\t\tfloat3 UnpackNormalU = WindForce_LandscapeSample_NormalVirtualTextureWorldToUvTransform[1].xyz;\r\n\t\tfloat3 UnpackNormalV = WindForce_LandscapeSample_NormalVirtualTextureWorldToUvTransform[2].xyz;\r\n\r\n\t\tFDFVector3 LwcWorldPos = DFFromTileOffset_Hack(MakeLWCVector3(WindForce_LandscapeSample_SystemLWCTile, InWorldPos));\r\n\t\tFDFVector3 LwcNormalOrigin = DFFromTileOffset_Hack(MakeLWCVector3(WindForce_LandscapeSample_NormalVirtualTextureLWCTile, UnpackNormalOrigin));\r\n\t\tfloat2 SampleUv = VirtualTextureWorldToUV(LwcWorldPos, LwcNormalOrigin, UnpackNormalU, UnpackNormalV);\r\n\r\n\t\tVTPageTableResult PageTable = TextureLoadVirtualPageTableLevel(\r\n\t\t\tWindForce_LandscapeSample_NormalVirtualTexturePageTable,\r\n\t\t\tVTPageTableUniform_Unpack(WindForce_LandscapeSample_NormalVirtualTexturePackedUniform0, WindForce_LandscapeSample_NormalVirtualTexturePackedUniform1),\r\n\t\t\tSampleUv,\r\n\t\t\tVTADDRESSMODE_CLAMP,\r\n\t\t\tVTADDRESSMODE_CLAMP,\r\n\t\t\t0.0f);\r\n\r\n\t\tfloat4 PackedValue0 = TextureVirtualSample(\r\n\t\t\tWindForce_LandscapeSample_NormalVirtualTexture0,\r\n\t\t\tWindForce_LandscapeSample_NormalVirtualTexture0Sampler,\r\n\t\t\tPageTable,\r\n\t\t\t0,\r\n\t\t\tVTUniform_Unpack(WindForce_LandscapeSample_NormalVirtualTextureUniforms0));\r\n\r\n\t\tfloat4 PackedValue1 = TextureVirtualSample(\r\n\t\t\tWindForce_LandscapeSample_NormalVirtualTexture1,\r\n\t\t\tWindForce_LandscapeSample_NormalVirtualTexture1Sampler,\r\n\t\t\tPageTable,\r\n\t\t\t0,\r\n\t\t\tVTUniform_Unpack(WindForce_LandscapeSample_NormalVirtualTextureUniforms1));\r\n\r\n\t\tif (WindForce_LandscapeSample_NormalVirtualTextureUnpackMode == VIRTUAL_TEXTURE_UNPACK_NORMAL_BC3BC3)\r\n\t\t{\r\n\t\t\tOutNormal = VirtualTextureUnpackNormalBC3BC3(PackedValue0, PackedValue1);\r\n\t\t}\r\n\t\telse if (WindForce_LandscapeSample_NormalVirtualTextureUnpackMode == VIRTUAL_TEXTURE_UNPACK_NORMAL_BC5BC1)\r\n\t\t{\r\n\t\t\tOutNormal = VirtualTextureUnpackNormalBC5BC1(PackedValue0, PackedValue1);\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tOutNormal = float3(0.0f, 0.0f, 1.0f);\r\n\t\t\tOutIsValid = false;\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tOutIsValid = true;\r\n\t}\r\n\telse if (WindForce_LandscapeSample_CachedHeightTextureEnabled != 0)\r\n\t{\r\n\t\tfloat2 InTextureCoordinates = GetCachedHeightTextureUv_WindForce_LandscapeSample(InWorldPos);\r\n\t\tfloat2 TextureSize = WindForce_LandscapeSample_CachedHeightTextureDimension.xy;\r\n\r\n\t\t// taken from LandscapeLayersPS.usf -> CalculateNormalsFromHeights()\r\n\t\tfloat2 TexelSize = 1.0 / TextureSize;\r\n\r\n\t\tfloat MaskMinBorderX = (InTextureCoordinates.x <= TexelSize.x) ? 0.0f : 1.0f;\t\t\t// first pixel X\r\n\t\tfloat MaskMinBorderY = (InTextureCoordinates.y <= TexelSize.y) ? 0.0f : 1.0f;\t\t\t// first pixel Y\r\n\t\tfloat MaskMaxBorderX = (InTextureCoordinates.x >= 1.0f - TexelSize.x) ? 0.0f : 1.0f;\t// last pixel X\r\n\t\tfloat MaskMaxBorderY = (InTextureCoordinates.y >= 1.0f - TexelSize.y) ? 0.0f : 1.0f;\t// last pixel Y\r\n\r\n\t\t// The triangle topology is the following (where C = center, T = top, B = bottom, L = left, R = right and Nx the normals we need to interpolate):\r\n\t\t// TL ------ TT\r\n\t\t// | \\       | \\\r\n\t\t// |  \\      |  \\\r\n\t\t// |   \\     |   \\\r\n\t\t// | N0 \\ N1 | N3 \\\r\n\t\t// |     \\   |     \\\r\n\t\t// |      \\  |      \\\r\n\t\t// |       \\ |       \\\r\n\t\t// LL ------ CC ------ RR\r\n\t\t//   \\       | \\       |\r\n\t\t//    \\      |  \\      |\r\n\t\t//     \\     |   \\     |\r\n\t\t//      \\ N2 | N4 \\ N5 |\r\n\t\t//       \\   |     \\   |\r\n\t\t//        \\  |      \\  |\r\n\t\t//         \\ |       \\ |\r\n\t\t//           BB ------ BR\r\n\t\t// So we can retrieve all 7 samples using 4 gathers : \r\n\t\t// Make sure we gather the 4 pixels in the bottom right direction by sampling at (0.75, 0.75) of the pixel (gather retrieves the 4 samples that would be used for bilinear interpolation):\r\n\r\n\t\tfloat2 GatherLocation = InTextureCoordinates + 0.25f * TexelSize; \r\n\t\tfloat4 Red0 = WindForce_LandscapeSample_CachedHeightTexture.GatherRed(WindForce_LandscapeSample_CachedHeightTextureSampler, GatherLocation - TexelSize);\r\n\t\tfloat4 Red1 = WindForce_LandscapeSample_CachedHeightTexture.GatherRed(WindForce_LandscapeSample_CachedHeightTextureSampler, GatherLocation);\r\n\r\n\t\t// [x,y,z] = World Position [w] = valid mask\r\n\t\tfloat4 TL = float4(float2(-1, -1) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red0.w, 1.0f);\r\n\t\tfloat4 TT = float4(float2(+0, -1) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red0.z, 1.0f);\r\n\t\tfloat4 CC = float4(float2(+0, +0) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red0.y, 1.0f);\r\n\t\tfloat4 LL = float4(float2(-1, +0) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red0.x, 1.0f);\r\n\t\tfloat4 RR = float4(float2(+1, +0) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red1.z, 1.0f);\r\n\t\tfloat4 BR = float4(float2(+1, +1) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red1.y, 1.0f);\r\n\t\tfloat4 BB = float4(float2(+0, +1) * WindForce_LandscapeSample_CachedHeightTextureWorldGridSize, Red1.x, 1.0f);\r\n\r\n\t\t// mask out samples that are off the edge of the texture\r\n\t\tTL.w *= MaskMinBorderX * MaskMinBorderY;\r\n\t\tTT.w *=                  MaskMinBorderY;\r\n\t\t// CC should never be off the edge\r\n\t\tLL.w *= MaskMinBorderX;\r\n\t\tRR.w *= MaskMaxBorderX;\r\n\t\tBR.w *= MaskMaxBorderX * MaskMaxBorderY;\r\n\t\tBB.w *=                  MaskMaxBorderY;\r\n\r\n\t\tfloat3 N0 = ComputeNullableTriangleNormal(CC, LL, TL);\r\n\t\tfloat3 N1 = ComputeNullableTriangleNormal(TL, TT, CC);\r\n\t\tfloat3 N2 = ComputeNullableTriangleNormal(LL, CC, BB);\r\n\t\tfloat3 N3 = ComputeNullableTriangleNormal(RR, CC, TT);\r\n\t\tfloat3 N4 = ComputeNullableTriangleNormal(BR, BB, CC);\r\n\t\tfloat3 N5 = ComputeNullableTriangleNormal(CC, RR, BR);\r\n\r\n\t\t// average the normals\r\n\t\tfloat3 FinalNormal = normalize(N0 + N1 + N2 + N3 + N4 + N5);\r\n\r\n\t\tOutNormal = normalize(mul(float4(FinalNormal, 0.0f), WindForce_LandscapeSample_CachedHeightTextureUvToWorldTransform).xyz);\r\n\t\tOutIsValid = true;\r\n\t}\r\n\telse\r\n\t{\r\n\t\tOutNormal = float3(0.0f, 0.0f, 1.0f);\r\n\t\tOutIsValid = false;\r\n\t}\r\n}\r\n\r\nvoid GetPhysicalMaterialIndex_WindForce_LandscapeSample(float3 InWorldPos, out int OutIndex, out bool OutIsValid)\r\n{\r\n\tfloat2 Uv = GetCachedHeightTextureUv_WindForce_LandscapeSample(InWorldPos);\r\n\r\n\tint3 SampleIndex = int3(Uv * WindForce_LandscapeSample_CachedPhysMatTextureDimension, 0);\r\n\tOutIndex = (int)WindForce_LandscapeSample_CachedPhysMatTexture.Load(SampleIndex).x;\r\n\r\n\tif (OutIndex >= 255)\r\n\t{\r\n\t\tOutIndex = -1;\r\n\t\tOutIsValid = false;\r\n\t}\r\n\telse\r\n\t{\r\n\t\tOutIsValid = true;\r\n\t}\r\n}\r\n\r\n#undef VIRTUAL_TEXTURE_UNPACK_NORMAL_NONE\r\n#undef VIRTUAL_TEXTURE_UNPACK_NORMAL_BC3BC3\r\n#undef VIRTUAL_TEXTURE_UNPACK_NORMAL_BC5BC1\r\n\n// Copyright Epic Games, Inc. All Rights Reserved.\r\n\r\nfloat3 WindForce_CollisionQuery_SystemLWCTile;\r\n\r\nvoid QuerySceneDepthGPU_WindForce_CollisionQuery(in float3 In_SamplePos, out float Out_SceneDepth, out float3 Out_CameraPosWorld, out bool Out_IsInsideView, out float3 Out_WorldPos, out float3 Out_WorldNormal)\r\n{\r\n\tNDICollisionQuery_QuerySceneDepthGPU(In_SamplePos, WindForce_CollisionQuery_SystemLWCTile, Out_SceneDepth, Out_CameraPosWorld, Out_IsInsideView, Out_WorldPos, Out_WorldNormal);\r\n}\r\n\r\nvoid QueryScenePartialDepthGPU_WindForce_CollisionQuery(in float3 In_SamplePos, out float Out_SceneDepth, out float3 Out_CameraPosWorld, out bool Out_IsInsideView, out float3 Out_WorldPos, out float3 Out_WorldNormal)\r\n{\r\n\tNDICollisionQuery_QueryScenePartialDepthGPU(In_SamplePos, WindForce_CollisionQuery_SystemLWCTile, Out_SceneDepth, Out_CameraPosWorld, Out_IsInsideView, Out_WorldPos, Out_WorldNormal);\r\n}\r\n\r\nvoid QueryCustomDepthGPU_WindForce_CollisionQuery(in float3 In_SamplePos, out float Out_SceneDepth, out float3 Out_CameraPosWorld, out bool Out_IsInsideView, out float3 Out_WorldPos, out float3 Out_WorldNormal)\r\n{\r\n\tNDICollisionQuery_QueryCustomDepthGPU(In_SamplePos, WindForce_CollisionQuery_SystemLWCTile, Out_SceneDepth, Out_CameraPosWorld, 